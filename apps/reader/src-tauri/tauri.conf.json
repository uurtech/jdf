{
  "productName": "JDF Reader",
  "version": "0.1.21",
  "identifier": "dev.jdf.viewer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JDF Reader",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc: http://ipc.localhost; img-src 'self' tauri: asset: data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' tauri: 'wasm-unsafe-eval'; worker-src 'self' blob:; font-src 'self' data: tauri: asset:; connect-src 'self' ipc: tauri: http://ipc.localhost; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../src-tauri/installer/LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "jdf"
        ],
        "mimeType": "application/jdf+json",
        "description": "JDF Document",
        "role": "Editor",
        "rank": "Owner",
        "name": "JDF Document"
      },
      {
        "ext": [
          "jdfx"
        ],
        "mimeType": "application/jdf+zip",
        "description": "JDF Bundle (zip)",
        "role": "Editor",
        "rank": "Owner",
        "name": "JDF Bundle"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "mimeType": "text/markdown",
        "description": "Markdown Document",
        "role": "Viewer",
        "rank": "Alternate",
        "name": "Markdown Document"
      },
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "description": "PDF Document",
        "role": "Viewer",
        "rank": "Alternate",
        "name": "PDF Document"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "en-US",
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": ["English", "Turkish"],
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "JDF Reader"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    }
  }
}
