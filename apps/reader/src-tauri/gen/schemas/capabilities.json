{"default":{"identifier":"default","description":"Default capabilities — scoped to user document directories so a malicious .jdfx (zip) opened from elsewhere cannot exfiltrate or overwrite arbitrary files. Tauri's open/save dialogs return paths the user explicitly chose; they're allowed implicitly by the dialog plugin and don't need broad fs scope.","local":true,"windows":["main","win-*"],"permissions":["core:default","core:event:default","core:event:allow-listen","core:event:allow-emit","core:window:allow-close","core:window:allow-destroy","dialog:default","dialog:allow-open","dialog:allow-save","fs:default",{"identifier":"fs:allow-read-text-file","allow":[{"path":"$HOME/Downloads/**"},{"path":"$HOME/Documents/**"},{"path":"$HOME/Desktop/**"},{"path":"/tmp/**"}]},{"identifier":"fs:allow-write-text-file","allow":[{"path":"$HOME/Downloads/**"},{"path":"$HOME/Documents/**"},{"path":"$HOME/Desktop/**"},{"path":"/tmp/**"}]},{"identifier":"fs:allow-read-file","allow":[{"path":"$HOME/Downloads/**"},{"path":"$HOME/Documents/**"},{"path":"$HOME/Desktop/**"},{"path":"/tmp/**"}]},{"identifier":"fs:allow-write-file","allow":[{"path":"$HOME/Downloads/**"},{"path":"$HOME/Documents/**"},{"path":"$HOME/Desktop/**"},{"path":"/tmp/**"}]},"fs:allow-exists"]}}