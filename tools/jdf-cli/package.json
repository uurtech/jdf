{
  "name": "@uurtech/jdf-cli",
  "version": "0.1.22",
  "description": "Command-line tool for the JDF (JSON Document Format) — validate and convert documents.",
  "license": "MIT",
  "author": "Ugur Kazdal",
  "homepage": "https://github.com/uurtech/jdf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uurtech/jdf.git",
    "directory": "tools/jdf-cli"
  },
  "bugs": {
    "url": "https://github.com/uurtech/jdf/issues"
  },
  "keywords": [
    "jdf",
    "json",
    "document",
    "cli",
    "validator",
    "ajv",
    "json-schema",
    "pdf-alternative",
    "pdf-to-json",
    "rag",
    "ai",
    "ci-cd"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "jdf": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@jdf/core": "workspace:*",
    "@jdf/pdf-import": "workspace:*",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0"
  }
}
