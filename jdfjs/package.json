{
  "name": "@uurtech/jdf",
  "version": "0.1.18",
  "description": "Render JDF (JSON Document Format) documents in the browser. Drop-in replacement for embedding PDFs — point at a .jdf file and it appears on the page, fully styled, searchable, with a clickable TOC.",
  "license": "MIT",
  "author": "Ugur Kazdal <ugur@uurtech.com>",
  "homepage": "https://github.com/uurtech/jdf#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/uurtech/jdf.git",
    "directory": "jdfjs"
  },
  "bugs": "https://github.com/uurtech/jdf/issues",
  "keywords": [
    "jdf",
    "json",
    "document",
    "viewer",
    "renderer",
    "embed",
    "pdf-alternative"
  ],
  "type": "module",
  "main": "./dist/jdfjs.js",
  "module": "./dist/jdfjs.js",
  "types": "./dist/jdfjs.d.ts",
  "browser": "./dist/jdfjs.js",
  "exports": {
    ".": {
      "types": "./dist/jdfjs.d.ts",
      "import": "./dist/jdfjs.js",
      "require": "./dist/jdfjs.cjs",
      "default": "./dist/jdfjs.js"
    },
    "./style.css": "./dist/jdfjs.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "demo": "vite serve examples",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@jdf/core": "workspace:*",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
