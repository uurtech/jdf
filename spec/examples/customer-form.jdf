{
  "$jdf": "1.0.0",
  "meta": {
    "title": "Customer Onboarding Form",
    "pageSize": { "width": 210, "height": 240 },
    "unit": "mm",
    "margins": { "top": 12, "right": 16, "bottom": 12, "left": 16 }
  },
  "pages": [
    {
      "id": "page-1",
      "elements": [
        {
          "type": "text",
          "content": "Customer Onboarding",
          "heading": 1,
          "position": { "x": 0, "y": 0 },
          "width": 178,
          "style": { "fontSize": 22, "fontWeight": "bold", "color": "#0f172a" }
        },
        {
          "type": "text",
          "content": "Type into any field — your input lives in the document. Click Save form to download a .jdf with your answers baked in.",
          "position": { "x": 0, "y": 12 },
          "width": 178,
          "style": { "fontSize": 11, "color": "#475569", "lineHeight": 1.4 }
        },

        {
          "type": "input",
          "name": "fullName",
          "label": "Full name",
          "inputType": "text",
          "value": "",
          "placeholder": "Jane Doe",
          "required": true,
          "position": { "x": 0, "y": 30 },
          "width": 178,
          "height": 16
        },
        {
          "type": "input",
          "name": "email",
          "label": "Email address",
          "inputType": "email",
          "value": "",
          "placeholder": "jane@example.com",
          "required": true,
          "position": { "x": 0, "y": 52 },
          "width": 178,
          "height": 16
        },
        {
          "type": "input",
          "name": "birthDate",
          "label": "Date of birth",
          "inputType": "date",
          "value": "",
          "position": { "x": 0, "y": 74 },
          "width": 86,
          "height": 16
        },
        {
          "type": "select",
          "name": "country",
          "label": "Country",
          "value": "tr",
          "options": [
            { "value": "tr", "label": "Turkey" },
            { "value": "us", "label": "United States" },
            { "value": "de", "label": "Germany" },
            { "value": "gb", "label": "United Kingdom" }
          ],
          "position": { "x": 92, "y": 74 },
          "width": 86,
          "height": 16
        },
        {
          "type": "textarea",
          "name": "notes",
          "label": "Anything we should know?",
          "value": "",
          "placeholder": "Tell us about your team, use case, anything…",
          "rows": 3,
          "position": { "x": 0, "y": 96 },
          "width": 178,
          "height": 36
        },
        {
          "type": "checkbox",
          "name": "newsletter",
          "label": "Email me product updates (about once a month)",
          "checked": false,
          "position": { "x": 0, "y": 138 },
          "width": 178,
          "height": 8
        },
        {
          "type": "checkbox",
          "name": "terms",
          "label": "I agree to the terms and conditions",
          "checked": false,
          "required": true,
          "position": { "x": 0, "y": 148 },
          "width": 178,
          "height": 8
        },
        {
          "type": "signature",
          "name": "signature",
          "label": "Sign here",
          "value": "",
          "position": { "x": 0, "y": 162 },
          "width": 178,
          "height": 32
        }
      ]
    }
  ]
}
