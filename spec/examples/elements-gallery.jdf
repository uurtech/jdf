        { "type": "input", "name": "full_name", "label": "Full name", "inputType": "text", "value": "Ada Lovelace", "position": { "x": 0, "y": 120 }, "width": 88, "height": 14 },
        { "type": "select", "name": "country", "label": "Country", "options": [ { "value": "tr", "label": "Turkey" }, { "value": "us", "label": "United States" } ], "value": "tr", "position": { "x": 94, "y": 120 }, "width": 88, "height": 14 },
        { "type": "textarea", "name": "notes", "label": "Notes", "rows": 3, "value": "", "placeholder": "Anything else?", "position": { "x": 0, "y": 138 }, "width": 182, "height": 24 },
