        { "type": "text", "id": "h1", "content": "Elements gallery", "heading": 1, "position": { "x": 0, "y": 0 }, "width": 182, "style": { "fontSize": 20, "fontWeight": "bold" } },
        { "type": "text", "content": "One fixture that uses every element type in the schema. scripts/parity-check.mjs renders it in jdf.js and the desktop reader and validates it with the CLI — if any surface drops or mislabels an element, the release is blocked.", "position": { "x": 0, "y": 10 }, "width": 182, "style": { "fontSize": 10, "color": "#334155" } },
        { "type": "toc", "depth": 2, "position": { "x": 0, "y": 24 }, "width": 182, "style": { "fontSize": 9, "color": "#334155" } },
        { "type": "richtext", "runs": [ { "text": "Rich text with " }, { "text": "bold", "bold": true }, { "text": ", " }, { "text": "italic", "italic": true }, { "text": " and a " }, { "text": "link", "link": "https://uurtech.github.io/jdf/" }, { "text": "." } ], "position": { "x": 0, "y": 34 }, "width": 182, "style": { "fontSize": 10 } },
        { "type": "list", "listType": "unordered", "items": [ { "content": "First item" }, { "content": "Second item", "items": [ { "content": "Nested item" } ] } ], "position": { "x": 0, "y": 42 }, "width": 90, "style": { "fontSize": 10 } },
        { "type": "table", "headers": [ "Region", "Revenue", "Churn" ], "rows": [ [ "EMEA", "1,204", "2.1%" ], [ "APAC", "980", "3.4%" ] ], "columns": [ { "width": 40 }, { "width": 30, "align": "right" }, { "width": 20, "align": "right" } ], "borders": true, "position": { "x": 92, "y": 42 }, "width": 90, "style": { "fontSize": 9 } },
        { "type": "shape", "shape": "rect", "position": { "x": 0, "y": 62 }, "width": 40, "height": 12, "fill": "#dbeafe", "stroke": "#2563eb", "strokeWidth": 0.5 },
        { "type": "image", "id": "img-1", "src": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==", "alt": "One blue pixel", "caption": "A 1×1 PNG carried inline — the smallest possible image element.", "captionSource": "author", "fit": "contain", "position": { "x": 44, "y": 62 }, "width": 40, "height": 12 },
        { "type": "video", "id": "vid-1", "src": "https://uurtech.github.io/jdf/demos/rag-benchmark.mp4", "title": "Benchmark trailer", "controls": true, "fit": "contain", "position": { "x": 88, "y": 62 }, "width": 94, "height": 53, "transcript": { "language": "en", "source": "manual", "segments": [ { "t0": 0, "t1": 3, "text": "PDF versus JDF, same pipeline." } ] } },
