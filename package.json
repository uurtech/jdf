{
  "name": "jdf",
  "version": "0.1.0",
  "private": true,
  "description": "JDF (JSON Document Format) \u2014 a human-readable, JSON-based document format. JDF Reader app, schema, CLI.",
  "scripts": {
    "dev": "pnpm --filter @jdf/reader dev",
    "build": "pnpm --filter @jdf/reader build",
    "tauri": "pnpm --filter @jdf/reader tauri",
    "typecheck": "pnpm -r typecheck",
    "parity": "node scripts/parity-check.mjs",
    "verify": "bash scripts/verify-all.sh",
    "verify:visual": "node scripts/verify/visual.mjs",
    "verify:forms": "node scripts/verify/forms.mjs",
    "verify:cli": "bash scripts/verify/cli.sh",
    "bench:render": "pnpm --filter @jdf/bench render"
  }
}
